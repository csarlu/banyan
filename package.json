{
  "name": "@csarlu/banyan",
  "version": "1.0.0",
  "description": "Polyglot Agentic Git Worktree & Local Dependency Control Plane TUI (Node, Python, Go, Rust, .NET)",
  "type": "module",
  "bin": {
    "bny": "dist/cli.js",
    "banyan-bin": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/csarlu/banyan.git"
  },
  "homepage": "https://github.com/csarlu/banyan#readme",
  "bugs": {
    "url": "https://github.com/csarlu/banyan/issues"
  },
  "scripts": {
    "build": "tsup src/cli.tsx --format esm --dts --clean --shims",
    "dev": "tsup src/cli.tsx --format esm --watch",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,json}\" \"tests/**/*.{ts,tsx,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,json}\" \"tests/**/*.{ts,tsx,js,json}\"",
    "audit": "npm audit",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "keywords": [
    "git",
    "worktree",
    "junctions",
    "symlinks",
    "agents",
    "polyglot",
    "python",
    "golang",
    "rust",
    "dotnet",
    "tui",
    "ink",
    "tmux",
    "psmux"
  ],
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "ink": "^5.0.1",
    "meow": "^13.2.0",
    "react": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
